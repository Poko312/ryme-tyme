# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Only NEXT_PUBLIC_* values are visible in the browser.

# --- Supabase (Project Settings → Data API / API Keys) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (starts with sb_publishable_). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (starts with sb_secret_). SERVER ONLY — bypasses all security rules.
SUPABASE_SECRET_KEY=

# --- Optional ---
# Public site URL used in email/OAuth links. Leave empty to auto-detect.
NEXT_PUBLIC_SITE_URL=

# --- Added in later steps ---
# Step 5: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PREMIUM_PRICE_ID
# Step 8: NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST
